# IC-Flow Platform 配置文件示例
# 复制为 config.yaml 并修改相应配置

# 消息总线配置
message_bus:
  type: redis
  redis:
    host: localhost
    port: 6379
    db: 0
    password: ""
    max_connections: 10

# 知识管理配置
knowledge:
  vector_db:
    type: qdrant
    url: http://localhost:6333
    collection: icflow_knowledge
    
  graph_db:
    type: neo4j
    uri: bolt://localhost:7687
    username: neo4j
    password: password
    
  relational_db:
    type: postgresql
    host: localhost
    port: 5432
    database: icflow
    username: postgres
    password: password

# 平台核心配置
platform:
  name: "IC-Flow Platform"
  version: "0.1.0"
  debug: false
  log_level: INFO
  
  # Flow Engine 自动注册
  auto_register_engines: true
  
  # Extension 自动加载
  auto_load_extensions: true
  extensions_dir: "./extensions"

# API 服务配置
api:
  host: "0.0.0.0"
  port: 8000
  workers: 4
  cors_origins:
    - "http://localhost:3000"
    - "http://localhost:8000"

# 监控配置
monitoring:
  enabled: true
  prometheus:
    port: 9090
  grafana:
    port: 3000
  jaeger:
    endpoint: "http://localhost:14268/api/traces"
  elk:
    elasticsearch_url: "http://localhost:9200"
    kibana_url: "http://localhost:5601"